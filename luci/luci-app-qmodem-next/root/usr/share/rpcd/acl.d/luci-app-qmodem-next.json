{
	"luci-app-qmodem-next": {
		"description": "Grant access to QModem Next application",
		"read": {
			"file": {
				"/sys/class/hwmon": [ "list" ],
				"/sys/class/hwmon/*": [ "list" ],
				"/sys/class/hwmon/*/*": [ "read" ],
				"/proc/net/if_inet6": [ "read" ],
				"/proc/sys/kernel/hostname": [ "read" ],
				"/proc/net/arp": [ "read" ],
				"/proc/net/route": [ "read" ]
			},
			"ubus": {
				"file": [ "list", "read" ],
				"luci-rpc": [ "getDHCPLeases", "getHostHints" ],
				"iwinfo": [ "assoclist" ],
				"network.wireless": [ "status" ],
				"network.device": [ "status" ],
				"network.interface": [ "status", "dump" ],
				"qmodem": [
					"*"
				],
				"qmodem.sms": [
					"status", "config_get", "sync_status", "list", "get", "modem_list", "storage_get"
				],
				"rc" : [ "list" ,"init"],
				"uci": [ "qmodem", "sms_forwarder", "cpe-dashboard" ]
			},
			"uci": [ "qmodem", "sms_forwarder", "cpe-dashboard", "wireless", "network", "ddns" ]
		},
		"write": {
			"ubus": {
				"qmodem": [
					"delete_sms",
					"do_reboot",
					"modem_dial",
					"modem_hang",
					"modem_redial",
					"scan_all",
					"scan_pcie",
					"scan_usb",
					"send_at",
					"send_raw_pdu",
					"send_sms",
					"set_imei",
					"set_lockband",
					"set_mode",
					"set_neighborcell",
					"set_network_prefer",
					"set_sms_storage"
				],
				"qmodem.sms": [
					"configure", "sync", "send", "delete", "mark_read",
					"modem_delete", "storage_set"
				],
				"uci": [ "qmodem", "sms_forwarder", "cpe-dashboard" ]
			},
			"uci": [ "qmodem", "sms_forwarder", "cpe-dashboard" ]
		}
	},
	"luci-mod-status-index": {
		"description": "Grant access to main status display",
		"read": {
			"ubus": {
				"qmodem": [ "cell_info","base_info" ]
			}
		}
	}
}
